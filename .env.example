# ===========================
# Gestcon - Variables para docker-compose
# Copia este archivo como .env y completa los valores
# ===========================

# App
PORT=3000
# En producción puedes poner múltiples orígenes separados por coma
# CLIENT_URL=https://gestcon.work,https://192.168.1.12
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_PORT=5432
DB_NAME=gestcon
DB_USER=postgres
DB_PASSWORD=cambia_esto_por_un_password_seguro
DB_TEST_NAME=gestcon_test

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=otro_secreto_diferente_muy_largo_y_aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# n8n — Automatización de workflows
# Genera con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia_esto_por_una_clave_hex_de_32_bytes

# RUES (verificación de terceros) — OPCIONAL. App token gratuito de datos.gov.co (Socrata).
# Funciona sin él; con él Socrata da un cupo de consultas propio.
# SOCRATA_APP_TOKEN=

# Deudas vencidas DIAN — llave con la que se CIFRAN las claves DIAN de las empresas (AES-256-GCM).
# OBLIGATORIA para guardar claves. 32 bytes en hex. Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala también fuera del servidor: si se pierde o cambia, las claves ya guardadas quedan
# ilegibles y hay que volver a cargarlas.
# DIAN_CLAVES_KEY=
# Revisiones simultáneas contra la DIAN (por defecto 2; el servidor tiene 2 núcleos y el generador
# de token comparte el mismo Chrome).
# DIAN_DEUDAS_MAX_CONCURRENTE=2
